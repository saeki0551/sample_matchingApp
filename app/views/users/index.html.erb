<% @users.each do |user| %>
  <% unless user == current_user %>
    <%= image_tag user.user_information.image, size: "50x50" %></br>
    <ul>
      <li><%= user.id %></li>
      <li><%= user.user_information.user_id %></li>
      <li>メールアドレス：<%= user.email %></li>
      <li>名前：<%= user.user_information.name %></li>
      <li>年齢：<%= user.user_information.age %></li>
      <li>生年月日：<%= user.user_information.birth_date %></li>
      <li>都道府県：<%= user.user_information.prefecture.name %></li>
      <li>趣味：<%= user.user_information.hobby.name %></li>
      <% if current_user.liked_user?(liked_user_id: user.id) %>
        <%= render partial: 'likes/destroy', locals: { like: current_user.likes.find_by(liked_user_id: user.id), user: user } %>
      <% else %>
        <% current_user_like = current_user.likes.new %>
        <% matching_judgement = user.liked_user?(liked_user_id: current_user_like.user_id) %>
        <%= render partial: 'likes/create', locals: { user_id: user.id, user: user, matching_judgement: matching_judgement }%>
      <% end %>
    </ul>
  <% end %>
<% end %>