<%= stylesheet_link_tag "users_index", media: "all" %>
<% @users.each do |user| %>
  <% unless user == current_user %>
    <div id="user">
      <li id="user-img_<%= user.id %>"><%= image_tag user.user_information.image %></li>
      <div class="user-like">
        <% if current_user.liked_user?(liked_user_id: user.id) %>
          <%= render partial: 'likes/destroy', locals: { like: current_user.likes.find_by(liked_user_id: user.id) } %>
        <% else %>
          <%= render partial: 'likes/create', locals: { user_id: user.id } %>
        <% end %>
      </div>
      <div class="user-data">
        <ul>
          <li><%= user.user_information.age %>歳</li>
          <li><%= user.user_information.prefecture.name %></li>
        </ul>
      </div>
      <div id="detail-user-information_<%= user.id %>"><%= render partial: 'show', locals: { user: user } %></div>
      <script>
        if (users == null) {
          var users = [];
        }
        var detail_user_information = document.getElementById("detail-user-information_<%= user.id %>");
        users.push(detail_user_information.id);
        var user_img = document.getElementById("user-img_<%= user.id %>");
        detail_user_information.style.display = 'none';
         user_img.addEventListener('click', function() {
          var user_img_id = this.id.replace(/[^0-9]/g, '');
          document.addEventListener('click', function() {
            var detail_user_information_id = users.find(user => user.includes(user_img_id));
            detail_user_information_id = document.getElementById(detail_user_information_id);
            console.log(detail_user_information_id);
            detail_user_information_id.style.display = 'block';
          });
        });
      </script>
    </div>
  <% end %>
<% end %>